{
  "name": "RobloxCS-Example",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "CS": {
        "$path": "out/Server"
      }
    },
    "ReplicatedStorage": {
